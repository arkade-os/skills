        }
      ]
    },
    {
      "name": "refund",
      "arkade": {
        "inputs": [],
        "asm": [
          "OP_INSPECTNUMINPUTS",
          "1",
          "OP_NUMEQUALVERIFY",
          "<deadline>",
          "OP_CHECKTIME",
          "OP_VERIFY",
          "0",
          "OP_INSPECTOUTPUTSCRIPTPUBKEY",
          "1",
          "OP_NUMEQUALVERIFY",
          "<payerProgram>",
          "OP_EQUALVERIFY",
          "0",
          "OP_INSPECTOUTPUTVALUE",
          "OP_PUSHCURRENTINPUTINDEX",
          "OP_INSPECTINPUTVALUE",
          "OP_GREATERTHANOREQUAL"
        ]
      },
      "leaves": [
        {
          "name": "refund",
          "asm": [
            "<deadline>",
            "OP_CHECKLOCKTIMEVERIFY",
            "OP_DROP",
            "<SERVER_KEY>",
            "OP_CHECKSIGVERIFY",
            "<EMULATOR_KEY:refund>",
            "OP_CHECKSIG"
          ],
          "witness": [
            {
              "name": "serverSig",
              "type": "signature",
              "encoding": "schnorr-64",
