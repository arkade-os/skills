      "leaves": [
        {
          "name": "release",
          "asm": [
            "<merchantPk>",
            "OP_CHECKSIGVERIFY",
            "<SERVER_KEY>",
            "OP_CHECKSIG"
          ],
          "witness": [
            {
              "name": "merchantSig",
              "type": "signature",
              "encoding": "schnorr-64"
            },
            {
              "name": "serverSig",
              "type": "signature",
              "encoding": "schnorr-64",
