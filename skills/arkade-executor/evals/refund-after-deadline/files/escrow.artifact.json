      ]
    },
    {
      "name": "exit",
      "leaves": [
        {
          "name": "exit",
          "asm": [
            "<exitDelay>",
            "OP_CHECKSEQUENCEVERIFY",
            "OP_DROP",
            "<payerPk>",
            "OP_CHECKSIG"
          ],
          "witness": [
            {
              "name": "payerSig",
              "type": "signature",
              "encoding": "schnorr-64"
            }
          ]
        }
      ]
